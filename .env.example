# Local HTTP development only. Production requires HTTPS, a random secret and SMTP.
APP_ENV=development
# Leave empty ONLY in development: generated into private storage/.auth-secret.
JWT_SECRET_KEY=
JWT_ISSUER=annotation-platform
JWT_AUDIENCE=annotation-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=60
IDLE_WARNING_MINUTES=5
ANNOTATION_ACTIVITY_IDLE_SECONDS=60
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
# Set smtp for real delivery; file is for offline development/tests only.
# EMAIL_BACKEND remains supported as a legacy alias when EMAIL_PROVIDER is unset.
EMAIL_PROVIDER=file
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Data Annotation Platform
# Fill SMTP_USERNAME / SMTP_FROM_EMAIL with your sender address and SMTP_PASSWORD
# with a Gmail App Password locally. Never use your regular Gmail password.
# Docker defaults persist model weights outside project folders (never deleted with a workspace).
# YOLO_MODEL_PATH=/app/storage/models/yolo11n.pt
# YOLO_SEG_MODEL_PATH=/app/storage/models/yolo11n-seg.pt
# For direct local Python use (Compose supplies its internal PostgreSQL URL):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/annotation
# STORAGE_PATH=./storage
# CORS_ORIGINS=http://localhost:5173
